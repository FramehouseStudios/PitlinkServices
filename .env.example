# PitlinkServices environment template.
# Copy to .env and fill in. Never commit .env.
# All commercial decisions live here or in founder-decided config — never in code.

# --- Core infrastructure ---
DATABASE_URL=postgres://pitlink:pitlink@localhost:5432/pitlink
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRY=1h

# --- Vendor adapters (all behind owned interfaces; see Contract Gate) ---
OPENAI_API_KEY=
MAPBOX_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Voice telephony provider: UNKNOWN_RFI (Twilio optional, founder decision pending)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Feature flags & commercial config (DECIDED values from canonical docs) ---
ENABLE_PREDICTIVE_ALERTS=false
ENABLE_PROVIDER_MARKETPLACE=true
DEFAULT_CITY=los-angeles

# --- Observability (planned; hooks only) ---
# SENTRY_DSN=
# OTLP_ENDPOINT=

# --- Service reliability (ESTIMATEs; ops-tunable, not commercial decisions) ---
RELIABILITY_SWEEP_SECONDS=30
RELIABILITY_REMATCH_SECONDS=60
RELIABILITY_ESCALATE_SECONDS=480
RELIABILITY_START_SECONDS=300
RELIABILITY_ARRIVAL_SECONDS=2700

# --- Provider quality gating (ESTIMATEs; suppression requires a real sample) ---
REPUTATION_MIN_ASSIGNMENTS=5
REPUTATION_MAX_NO_SHOW_RATE=0.3
REPUTATION_MIN_RATINGS=3
REPUTATION_MIN_AVG_RATING=2.5
